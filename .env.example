# ============================================================
# Steam 게임 분석 프로젝트 - 환경변수 예시 (값은 비워 둠)
# ============================================================
# 사용: 이 파일을 .env로 복사한 뒤 값을 채움 (cp .env.example .env)
# docker-compose-local.yml의 ${...} 참조가 이 값으로 치환됨
# Airflow Connection·Variable도 이 값으로 자동 등록되므로 UI 등록 불필요
#
# 주의
# - 필수 항목이 비어 있으면 compose가 기동을 거부함
# - 값은 컨테이너 "생성 시점"에 반영됨. 변경 후 up -d --force-recreate 필요
# - DB·S3 계정은 볼륨 최초 생성 시에만 적용됨. 기존 볼륨이 있으면 바꾸지 말 것
# - 비밀번호에 @ : / ? & 가 있으면 연결 URL이 깨지므로 영문·숫자 권장
# - 서버(.env)는 로컬과 다른 새 값을 사용하고 Git에 올리지 않음
# ============================================================

# ------------------------------------------------------------
# Airflow (필수)
# ------------------------------------------------------------
# Connection·Variable 암호화 키, 기존 메타DB가 있으면 바꾸지 말 것
# 생성: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=

# Airflow 메타DB (airflow-postgres)
AIRFLOW_DB_USER=
AIRFLOW_DB_PASSWORD=
AIRFLOW_DB_NAME=

# Airflow 웹 UI 관리자 계정 (airflow-init 실행 시 생성)
AIRFLOW_ADMIN_USER=
AIRFLOW_ADMIN_PASSWORD=

# ------------------------------------------------------------
# 분석 DB (analytics-postgres) → Connection "analytics_db" (필수)
# ------------------------------------------------------------
# failover 시 HOST를 analytics-postgres-replica로 바꾸고 컨테이너 재생성
ANALYTICS_DB_HOST=analytics-postgres
ANALYTICS_DB_USER=
ANALYTICS_DB_PASSWORD=
ANALYTICS_DB_NAME=steam_analytics

# 복제 계정(replicator) 비밀번호 (복제본을 쓸 때 필수)
REPLICATOR_PASSWORD=

# 분석 DB 읽기 전용 계정 (시각화 도구·에이전트 연결용)
ANALYTICS_READONLY_USER=
ANALYTICS_READONLY_PASSWORD=

# ------------------------------------------------------------
# S3 호환 저장소 (SeaweedFS) → Connection "s3_storage"
# ------------------------------------------------------------
# 비우면 로컬 기본값 사용. 서버는 반드시 새 값 지정
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ------------------------------------------------------------
# Steam API → Variable "steam_api_key" (필수)
# ------------------------------------------------------------
# 발급: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# ------------------------------------------------------------
# Slack 알림 (선택, 비우면 외부로 알림을 보내지 않음)
# ------------------------------------------------------------
SLACK_WEBHOOK_URL=

# ------------------------------------------------------------
# Snowflake (선택) → Connection "snowflake_default"
# ------------------------------------------------------------
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_ROLE=
